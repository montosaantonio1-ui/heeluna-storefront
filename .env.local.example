# Shopify Storefront API (public-facing, read + cart/checkout only — never the Admin API token here)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_storefront_api_token
SHOPIFY_STOREFRONT_API_VERSION=2024-10

# Handle (slug) of the product this single-product store sells.
# Shopify slugifies the title automatically — update this once the product
# is published (Shopify Admin → Products → the product → the handle shown
# under the title, or in the product URL).
NEXT_PUBLIC_PRODUCT_HANDLE=heeluna-pro-electric-callus-remover

# Meta (Facebook/Instagram) Pixel — optional. Leave unset and the storefront
# simply won't load the pixel. Get this from Meta Events Manager
# (business.facebook.com -> Events Manager -> Connect data sources -> Web).
NEXT_PUBLIC_META_PIXEL_ID=
